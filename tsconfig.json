{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "noUncheckedIndexedAccess": false,
    "paths": {
      "@deepseek-ai/cordis": [
        "../deepseek-harness/vendor/cordis/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-agent": [
        "../deepseek-harness/packages/core/agent/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-tools": [
        "../deepseek-harness/packages/core/tools/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-host-webserver": [
        "../deepseek-harness/packages/host/webserver/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-connection": [
        "../deepseek-harness/packages/client/connection/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-attachment": [
        "../deepseek-harness/packages/attachment/attachment/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-ui-sidebar-right/client": [
        "../deepseek-harness/packages/client/ui-sidebar-right/lib/types/client/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-ui-slots": [
        "../deepseek-harness/packages/client/ui-slots/lib/types/index.d.ts"
      ],
      "@deepseek-ai/schemastery": [
        "../deepseek-harness/vendor/schemastery/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-ui-renderer/client": [
        "../deepseek-harness/packages/client/ui-renderer/lib/types/client/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-ui-session/client": [
        "../deepseek-harness/packages/client/ui-session/lib/types/client/index.d.ts"
      ]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts"
  ]
}
